# Railway provides this for its Postgres service (use the pgvector template).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flatfee

# Email through Resend (https://resend.com). Without a key, emails are logged instead of sent.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Flat Fee Network <hello@yourdomain.com>"
EMAIL_FROM=
# Public address of the site, used in email links
SITE_URL=https://flatfeenetwork-production.up.railway.app
# Gets an email when a claim needs review; signs in to /admin/claims
ADMIN_EMAIL=
